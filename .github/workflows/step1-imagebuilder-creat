name: Build iStoreOS + ImageBuilder (25.12)  
  
on:  
  workflow_dispatch:  
    inputs:  
      profile:  
        description: '设备 PROFILE（TARGET_DEVICES 名，如 easepi_ars4）'  
        required: true  
        default: 'easepi_ars4'  
      extra_packages:  
        description: '额外打包进固件的软件包（空格分隔）'  
        required: false  
        default: ''  
  push:  
    branches: [ istoreos-25.12 ]  
  
env:  
  TARGET: rockchip  
  SUBTARGET: rk35xx  
  BRANCH: istoreos-25.12  
  
jobs:  
  build:  
    runs-on: ubuntu-24.04  
    steps:  
      - name: 安装编译依赖  
        run: |  
          sudo apt-get update  
          sudo apt-get install -y build-essential clang flex bison g++ gawk \  
            gcc-multilib g++-multilib gettext git libncurses-dev libssl-dev \  
            python3 python3-dev python3-setuptools rsync unzip zlib1g-dev \  
            file wget swig qemu-utils  
  
      - name: 拉取 25.12 分支源码  
        uses: actions/checkout@v4  
        with:  
          ref: ${{ env.BRANCH }}  
          fetch-depth: 0  
  
      - name: 更新并安装 feeds  
        run: |  
          ./scripts/feeds update -a  
          ./scripts/feeds install -a  
  
      - name: 生成 .config（目标 + 设备 + ImageBuilder）  
        run: |  
          PROFILE="${{ github.event.inputs.profile || 'easepi_ars4' }}"  
          cat > .config <<EOF  
          CONFIG_TARGET_${TARGET}=y  
          CONFIG_TARGET_${TARGET}_${SUBTARGET}=y  
          CONFIG_TARGET_${TARGET}_${SUBTARGET}_DEVICE_${PROFILE}=y  
          CONFIG_IB=y  
          CONFIG_SDK=n  
          CONFIG_MAKE_TOOLCHAIN=n  
          EOF  
          make defconfig  
  
      - name: 下载源码包  
        run: make download -j$(nproc)  
  
      - name: 编译固件与 ImageBuilder  
        run: make -j$(nproc) V=s  
  
      - name: 解压 ImageBuilder 并用它重新打包镜像  
        run: |  
          IB=$(ls bin/targets/${TARGET}/${SUBTARGET}/*imagebuilder*.tar.xz | head -n1)  
          mkdir -p ib && tar -xJf "$IB" -C ib --strip-components=1  
          cd ib  
          make image PROFILE="${{ github.event.inputs.profile || 'easepi_ars4' }}" \  
            PACKAGES="${{ github.event.inputs.extra_packages }}" \  
            BIN_DIR="$(pwd)/out"  
  
      - name: 上传固件产物  
        uses: actions/upload-artifact@v4  
        with:  
          name: istoreos-25.12-${{ github.event.inputs.profile || 'easepi_ars4' }}  
          path: |  
            bin/targets/rockchip/rk35xx/*.img.gz  
            ib/out/  
          retention-days: 7  
  
      - name: 上传 ImageBuilder  
        uses: actions/upload-artifact@v4  
        with:  
          name: imagebuilder-25.12-rockchip-rk35xx  
          path: bin/targets/rockchip/rk35xx/*imagebuilder*.tar.xz  
          retention-days: 7
